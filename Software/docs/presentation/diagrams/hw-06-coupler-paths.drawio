><mxGeometry x="1376" y="92" width="210" height="26" as="geometry"/></mxCell><mxCell id="r63" value="&lt;span style=&quot;font-size:22px&quot;&gt;&lt;b&gt;S11 = P1_BWD − P1_FWD&amp;emsp;&amp;emsp;&amp;emsp;S21 = P2_BWD − P1_FWD&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#8B949E;font-size:15px&quot;&gt;Source on port 2 is the mirror image: S22 = P2_BWD − P2_FWD,  S12 = P1_BWD − P2_FWD.  The pad gives the unused side the same loss as switches + coupler.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1C2128;strokeColor=#3FB950;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;opacity=100;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="745" width="1520" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>