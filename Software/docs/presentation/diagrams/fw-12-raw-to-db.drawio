endArrow=block;endFill=1;startArrow=none;startFill=1;endSize=7;startSize=7;fontColor=#3FB950;fontFamily=Segoe UI;fontSize=12;fontStyle=1;labelBackgroundColor=#121417;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="714" y="400.0" as="sourcePoint"/><mxPoint x="760" y="400.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t17" value="yes" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="386" width="40" height="28" as="geometry"/></mxCell><mxCell id="l18" value="" style="edgeStyle=none;rounded=1;html=1;strokeColor=#FF7B72;strokeWidth=2.5;endArrow=block;endFill=1;startArrow=none;startFill=1;endSize=7;startSize=7;fontColor=#FF7B72;fontFamily=Segoe UI;fontSize=12;fontStyle=1;labelBackgroundColor=#121417;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="714" y="428.0" as="sourcePoint"/><mxPoint x="760" y="428.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t19" value="no" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="414" width="40" height="28" as="geometry"/></mxCell><mxCell id="r21" value="&lt;span style=&quot;color:#8B949E;font-size:14px&quot;&gt;linear&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas;font-size:18px&quot;&gt;f(i) = f0 + (f1 − f0) · i / (n − 1)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#8B949E;font-size:13px&quot;&gt;exact integer Hz&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1C2128;strokeColor=#8B949E;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;opacity=100;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="700" height="110" as="geometry"/></mxCell><mxCell id="r22" value="&lt;span style=&quot;color:#8B949E;font-size:14px&quot;&gt;logarithmic&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas;font-size:18px&quot;&gt;f(i) = exp(ln f0 + (ln f1 − ln f0) · i / (n − 1))&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#8B949E;font-size:13px&quot;&gt;rounded to the Hz&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1C2128;strokeColor=#8B949E;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;opacity=100;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="700" height="110" as="geometry"/></mxCell><mxCell id="t23" value="Firmware and client compute the same grid, so the client can draw placeholders before the data arrives; missing points stay gaps." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="1440" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>