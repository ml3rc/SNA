<mxfile host="drawio" type="device"><diagram name="fw-12-raw-to-db" id="fw-12-raw-to-db"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#121417" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#121417;strokeColor=none;movable=0;resizable=0;editable=0;deletable=0;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="g20" value="Frequency grid — computed, never sent" style="rounded=1;arcSize=3;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8B949E;strokeWidth=1.5;dashed=1;dashPattern=8 5;fontColor=#8B949E;fontFamily=Segoe UI;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1520" height="300" as="geometry"/></mxCell><mxCell id="t1" value="Raw codes → calibrated dB" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="40" as="geometry"/></mxCell><mxCell id="t2" value="Done on core 0 for every point, while core 1 already measures the next one" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#8B949E;fontFamily=Segoe UI;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="26" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;ADC medians&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#8B949E&quot;&gt;reference path&lt;br&gt;measured path&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1C2128;strokeColor=#A371F7;strokeWidth=2;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=