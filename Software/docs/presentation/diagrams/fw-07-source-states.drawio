<mxfile host="drawio" type="device"><diagram name="fw-07-source-states" id="fw-07-source-states"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#121417" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#121417;strokeColor=none;movable=0;resizable=0;editable=0;deletable=0;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="t1" value="RF source — OFF · PARKED · ON" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="40" as="geometry"/></mxCell><mxCell id="t2" value="Every change goes through rf_state_set_source() so the order is always safe" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#8B949E;fontFamily=Segoe UI;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="26" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;OFF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#8B949E&quot;&gt;synth + amp powered down&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1C2128;strokeColor=#8B949E;strokeWidth=2;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=28;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="280" height="150" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;PARKED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#8B949E&quot;&gt;running · output terminated&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1C2128;strokeColor=#F2CC60;strokeWidth=2;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=28;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="260" width="280" height="150" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;ON&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#8B949E&quot;&gt;routed to port 1 or 2&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1C2128;strokeColor=#F78166;strokeWidth=2;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=28;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1240" y="260" width="280" height="150" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;html=1;strokeColor=#F78166;strokeWidth=2.5;endArrow=block;endFill=1;startArrow=none;startFill=1;endSize=7;startSize=7;fontColor=#F78166;fontFamily=Segoe UI;fontSize=12;fontStyle=1;labelBackgroundColor=#121417;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;html=1;strokeColor=#F2CC60;strokeWidth=2.5;endArrow=block;endFill=1;startArrow=none;startFill=1;endSize=7;startSize=7;fontColor=#F2CC60;fontFamily=Segoe UI;fontSize=12;fontStyle=1;labelBackgroundColor=#121417;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t8" value="&lt;span style=&quot;color:#F78166&quot;&gt;&lt;b&gt;1.&lt;/b&gt; port switch → port&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; release attenuator&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=15;align=left;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="950" y="160" width="290" height="90" as="geometry"/></mxCell><mxCell id="t9" value="&lt;span style=&quot;color:#F2CC60&quot;&gt;&lt;b&gt;1.&lt;/b&gt; attenuator → 127 (max)&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; switch → 50 Ω&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="950" y="420" width="290" height="90" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;html=1;strokeColor=#8B949E;strokeWidth=2.5;endArrow=block;endFill=1;startArrow=none;startFill=1;endSize=7;startSize=7;fontColor=#8B949E;fontFamily=Segoe UI;fontSize=12;fontStyle=1;labelBackgroundColor=#121417;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;html=1;strokeColor=#8B949E;strokeWidth=2.5;endArrow=block;endFill=1;startArrow=none;startFill=1;endSize=7;startSize=7;fontColor=#8B949E;fontFamily=Segoe UI;fontSize=12;fontStyle=1;labelBackgroundColor=#121417;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t12" value="&lt;span style=&quot;color:#8B949E&quot;&gt;manual src_en: false&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=15;align=left;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="370" y="170" width="290" height="80" as="geometry"/></mxCell><mxCell id="t13" value="&lt;span style=&quot;color:#E6EDF3&quot;&gt;power up → registers written&lt;br&gt;&lt;b&gt;twice, ≥ 20 ms apart&lt;/b&gt;&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="370" y="420" width="290" height="90" as="geometry"/></mxCell><mxCell id="e14" value="park first, then power down" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;html=1;strokeColor=#8B949E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;endSize=7;startSize=7;fontColor=#8B949E;fontFamily=Segoe UI;fontSize=12;fontStyle=1;labelBackgroundColor=#121417;jumpStyle=arc;jumpSize=10;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b3"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="140"/><mxPoint x="220" y="140"/></Array></mxGeometry></mxCell><mxCell id="r15" value="&lt;span style=&quot;font-size:20px;color:#FF7B72&quot;&gt;&lt;b&gt;Why the order matters&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;The amplifier delivers about 12–15 dBm at 0 dB attenuation. Switching to the termination first would dump that into the switch&#x27;s 50 Ω resistor.&lt;br&gt;So: attenuate fully before terminating, and route before releasing the attenuator.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1C2128;strokeColor=#FF7B72;fontColor=#E6EDF3;fontFamily=Segoe UI;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;opacity=100;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="580" width="1440" height="130" as="geometry"/></mxCell><mxCell id="t16" value="Between sweeps the source stays PARKED and running: stable temperature, fast retune, no repeated power-up." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#8B949E;fontFamily=Segoe UI;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="750" width="1440" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>